# Copy to .env (never commit .env). Docker Compose reads it automatically.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8002,http://127.0.0.1:8002
# Set true only when served over HTTPS
DJANGO_SECURE_COOKIES=False
# First-run admin (created only if the user does not exist yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
ADMIN_EMAIL=
MAX_UPLOAD_MB=5
LOG_LEVEL=INFO
